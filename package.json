{
  "name": "postgres-ssh-mcp",
  "type": "module",
  "version": "0.0.0",
  "description": "MCP server for Postgres (with SSH tunnel support)",
  "author": "SecretX33 <notyetmidnight@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/SecretX33/postgres-ssh-mcp#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/SecretX33/postgres-ssh-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/SecretX33/postgres-ssh-mcp/issues"
  },
  "bin": {
    "postgres-ssh-mcp": "./dist/index.js"
  },
  "exports": {
    ".": "./dist/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "mcp",
    "claude",
    "postgres",
    "ssh"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch --env.NODE_ENV=development",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "format": "prettier --check --cache src tests",
    "format:write": "prettier --write --cache src tests"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.29.0",
    "@pgsql/traverse": "17.2.6",
    "pg": "8.21.0",
    "pgsql-parser": "17.9.15",
    "tunnel-ssh": "5.2.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "25.9.1",
    "@types/pg": "8.20.0",
    "@types/ssh2": "1.15.5",
    "@typescript/native-preview": "7.0.0-dev.20260328.1",
    "prettier": "3.8.3",
    "tsdown": "0.22.0",
    "typescript": "5.9.3",
    "vitest": "4.1.6"
  }
}
